# Jekyll Production Container
# Multi-stage build for optimized image size

FROM docker.io/ruby:3.2-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    build-base \
    gcc \
    cmake \
    git \
    nodejs \
    npm

# Install Jekyll and Bundler
RUN gem install jekyll bundler

# Set working directory
WORKDIR /site

# This stage will be used to build sites
# Sites will be mounted at /site during runtime

# ============================================
# Production stage
FROM docker.io/ruby:3.2-alpine

LABEL maintainer="gautama-system"
LABEL description="Jekyll static site generator for production"
LABEL version="1.0"

# Install runtime dependencies only
RUN apk add --no-cache \
    libstdc++ \
    nodejs \
    tzdata

# Install Jekyll and Bundler
RUN gem install jekyll bundler webrick

# Create non-root user for security
RUN addgroup -g 1000 jekyll && \
    adduser -D -u 1000 -G jekyll jekyll

# Set working directory
WORKDIR /site

# Change ownership
RUN chown -R jekyll:jekyll /site

# Switch to non-root user
USER jekyll

# Expose Jekyll default port
EXPOSE 4000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:4000/ || exit 1

# Default command: serve Jekyll site
# Override with specific site configuration if needed
CMD ["jekyll", "serve", "--host", "0.0.0.0", "--port", "4000", "--livereload", "--incremental", "--force_polling"]
