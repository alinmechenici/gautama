# SOPS Secrets Template for Gautama
#
# This file shows all required secrets for the Gautama configuration.
# DO NOT commit actual secrets! This is just a template.
#
# To use:
# 1. Copy this file: cp secrets.yaml.example secrets.yaml
# 2. Generate age key: age-keygen -o ~/.config/sops/age/keys.txt
# 3. Configure SOPS: Create .sops.yaml with your age public key
# 4. Edit secrets: sops secrets.yaml
# 5. Fill in actual values (examples below are placeholders)

# Certificate Authority
step-ca-password: "REPLACE_WITH_SECURE_PASSWORD"

# Backups
restic-password: "REPLACE_WITH_LONG_RANDOM_PASSWORD"
aws-keys: |
  AWS_ACCESS_KEY_ID=REPLACE_WITH_B2_KEY_ID
  AWS_SECRET_ACCESS_KEY=REPLACE_WITH_B2_APPLICATION_KEY

# Mail - Fastmail
johnw-fastmail-password: "REPLACE_WITH_FASTMAIL_APP_PASSWORD"

# Mail - Gmail
carmichael-imap-gmail-com: "REPLACE_WITH_GMAIL_APP_PASSWORD"

# Databases
postgresql-johnw-password: "REPLACE_WITH_SECURE_PASSWORD"
postgresql-assembly-password: "REPLACE_WITH_SECURE_PASSWORD"

# Home Assistant
homeassistant-secret-key: "REPLACE_WITH_RANDOM_64_CHAR_HEX"

# Redmine (Project Management)
redmine-db-password: "REPLACE_WITH_SECURE_PASSWORD"
redmine-secret-key-base: "REPLACE_WITH_RANDOM_128_CHAR_HEX"

# Nextcloud
nextcloud-admin-password: "REPLACE_WITH_SECURE_PASSWORD"

# Gitea
gitea-secret-key: "REPLACE_WITH_RANDOM_SECRET"
gitea-internal-token: "REPLACE_WITH_RANDOM_TOKEN"
gitea-lfs-jwt-secret: "REPLACE_WITH_RANDOM_SECRET"

# N8N
n8n-encryption-key: "REPLACE_WITH_RANDOM_32_CHAR_STRING"

# LiteLLM
litellm-master-key: "REPLACE_WITH_RANDOM_API_KEY"
litellm-database-url: "postgresql://litellm:PASSWORD@localhost/litellm"

# API Keys (Optional - add as needed)
openai-api-key: "sk-REPLACE_WITH_OPENAI_KEY"
anthropic-api-key: "sk-ant-REPLACE_WITH_ANTHROPIC_KEY"

# Monitoring
grafana-admin-password: "REPLACE_WITH_SECURE_PASSWORD"
prometheus-web-auth: "admin:REPLACE_WITH_BCRYPT_HASH"

# SSH Keys (Optional - for automated deployments)
deploy-ssh-key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  REPLACE_WITH_ACTUAL_SSH_PRIVATE_KEY
  -----END OPENSSH PRIVATE KEY-----

# Cloudflare (Optional - if using Cloudflare tunnels)
cloudflare-tunnel-token: "REPLACE_WITH_CLOUDFLARE_TOKEN"

# Tailscale (Optional - if managing via secrets)
tailscale-auth-key: "tskey-REPLACE_WITH_TAILSCALE_AUTH_KEY"

# Notes:
# - Generate strong passwords: openssl rand -base64 32
# - Generate hex strings: openssl rand -hex 64
# - For bcrypt hashes: htpasswd -nbB admin password
# - B2 credentials: Get from Backblaze B2 console
# - App passwords: Generate in respective service settings
# - Keep secrets.yaml ENCRYPTED with SOPS
# - Never commit unencrypted secrets to git!

# Minimum Required Secrets:
# - step-ca-password (for certificate authority)
# - restic-password (for backups)
# - aws-keys (for Backblaze B2 backups)
# - Mail passwords (if using mail sync)
#
# Optional secrets depend on which services you enable.
